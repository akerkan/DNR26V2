                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Kundenname1">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=
  IIF(IsNothing(Fields!Kundenname.Value) OR Fields!Kundenname.Value = "", "", Fields!Kundenname.Value)
&amp; IIF(IsNothing(Fields!Name2.Value) OR Fields!Name2.Value = "", "", vbCrLf &amp; Fields!Name2.Value)
&amp; IIF(IsNothing(Fields!Inhaber.Value) OR Fields!Inhaber.Value = "", "", vbCrLf &amp; Fields!Inhaber.Value)
&amp; IIF(Not IsNothing(Fields!Adresse.Value) And Fields!Adresse.Value &lt;&gt; "", vbCrLf &amp; Fields!Adresse.Value, "")
&amp; IIF(IsNothing(Fields!Adresse2.Value), "", IIF(Fields!Adresse2.Value = "", "", vbCrLf &amp; Fields!Adresse2.Value))
&amp; IIF(IsNothing(Fields!PLZ.Value) And IsNothing(Fields!Ort.Value), "",vbCrLf &amp; Trim(
  IIF(IsNothing(Fields!PLZ.Value), "", Fields!PLZ.Value) &amp;
  IIF(IsNothing(Fields!Ort.Value), "", " " &amp; Fields!Ort.Value)))
&amp; IIF(IsNothing(Fields!Land.Value), "", IIF(Fields!Land.Value = "", "", vbCrLf &amp; Fields!Land.Value))</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Kundenname1</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <rd:Selected>true</rd:Selected>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ALName2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=
IIF(IsNothing(Fields!ALAdresse.Value) OR Fields!ALAdresse.Value = "", "", "Lieferadresse")
&amp; IIF(IsNothing(Fields!ALName2.Value) OR Fields!ALName2.Value = "", "", vbCrLf &amp; Fields!ALName2.Value)
&amp; IIF(IsNothing(Fields!ALInhaber.Value) OR Fields!ALInhaber.Value = "", "", vbCrLf &amp; Fields!ALInhaber.Value)
&amp; IIF(Not IsNothing(Fields!ALAdresse.Value) And Fields!ALAdresse.Value &lt;&gt; "", vbCrLf &amp; Fields!ALAdresse.Value, "")
&amp; IIF(IsNothing(Fields!ALAdresse2.Value), "", IIF(Fields!ALAdresse2.Value = "", "", vbCrLf &amp; Fields!ALAdresse2.Value))
&amp; IIF(
    IsNothing(Fields!ALPLZ.Value) And IsNothing(Fields!ALOrt.Value), "",
    vbCrLf &amp; Trim(
        IIF(IsNothing(Fields!ALPLZ.Value), "", Fields!ALPLZ.Value) &amp;
        IIF(IsNothing(Fields!ALOrt.Value), "", " " &amp; Fields!ALOrt.Value)
    )
)
&amp; IIF(IsNothing(Fields!ALLand.Value), "", IIF(Fields!ALLand.Value = "", "", vbCrLf &amp; Fields!ALLand.Value))</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>ALName2</rd:DefaultName>
